{
  "test_cases": [
    {
      "id": "TC001",
      "name": "Valid server configuration",
      "description": "Test starting server with valid configuration",
      "input": {
        "server_name": "test-server",
        "config_file": "tests/fixtures/valid-server.env"
      },
      "expected": {
        "exit_code": 0,
        "container_running": true,
        "logs_contain": "Done"
      }
    },
    {
      "id": "TC002",
      "name": "Invalid server configuration",
      "description": "Test error handling with invalid configuration",
      "input": {
        "server_name": "invalid-server",
        "config_file": "tests/fixtures/invalid-server.env"
      },
      "expected": {
        "exit_code": 1,
        "error_message": "Invalid configuration"
      }
    },
    {
      "id": "TC003",
      "name": "Missing configuration file",
      "description": "Test behavior when config file doesn't exist",
      "input": {
        "server_name": "missing-config",
        "config_file": "nonexistent.env"
      },
      "expected": {
        "exit_code": 1,
        "error_message": "Configuration file not found"
      }
    },
    {
      "id": "TC004",
      "name": "Docker daemon not running",
      "description": "Test behavior when Docker is not available",
      "input": {
        "server_name": "no-docker",
        "config_file": "tests/fixtures/valid-server.env",
        "docker_stopped": true
      },
      "expected": {
        "exit_code": 1,
        "error_message": "Docker daemon not running"
      }
    }
  ],
  "test_data": {
    "server_configs": {
      "vanilla": {
        "type": "VANILLA",
        "version": "1.20.1",
        "memory": "2G",
        "cpu_count": "2"
      },
      "modded": {
        "type": "FORGE",
        "version": "1.19.2",
        "memory": "4G",
        "cpu_count": "4"
      }
    },
    "docker_images": [
      "itzg/minecraft-server:latest",
      "itzg/minecraft-server:java17",
      "itzg/minecraft-server:java8"
    ],
    "ports": {
      "minecraft": 25565,
      "rcon": 25575,
      "query": 25577
    }
  },
  "expected_outputs": {
    "success_messages": [
      "Starting minecraft server",
      "Building image",
      "Creating container",
      "Starting container",
      "Server started successfully"
    ],
    "error_messages": [
      "Configuration file not found",
      "Invalid configuration",
      "Docker daemon not running",
      "Container creation failed",
      "Server startup failed"
    ]
  }
}
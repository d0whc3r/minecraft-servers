# BATS Test Pipeline Configuration
# ================================
#
# This file serves as the single source of truth for pipeline configuration.
# All workflows (.github/workflows/*.yml) read from this file to ensure consistency.
#
# Usage:
# - Modify values here to change pipeline behavior
# - Workflows will use these values with fallbacks to defaults
# - Changes here affect: bats-tests.yml
#
# This file contains configuration overrides for the BATS test pipeline
# Values here will override defaults in the workflow

# Test execution settings
# Internal bats timeout (minutes). Kept below the job-level timeout-minutes (test: 25)
# so the bats step is killed gracefully and artifacts still upload before the hard job cap.
TEST_TIMEOUT_MINUTES=20
PARALLEL_JOBS=1

# Docker settings
DOCKER_VERSION=28.5.2

# Dependency versions
# NODE_VERSION is now taken from .nvmrc
# PNPM_VERSION is now taken from package.json packageManager field

# Chunking strategy — modpacks per test job (consumed by prepare-matrix):
# - small:  1 modpack per chunk  (more, faster jobs)
# - medium: 2 modpacks per chunk (balanced - CURRENT)
# - large:  3 modpacks per chunk (fewer, slower jobs)
CHUNK_STRATEGY=medium

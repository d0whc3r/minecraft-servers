{
  "name": "minecraft-servers",
  "version": "1.0.0",
  "description": "Minecraft server management system with automated testing suite",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/d0whc3r/minecraft-servers.git"
  },
  "homepage": "https://github.com/d0whc3r/minecraft-servers#readme",
  "bugs": {
    "url": "https://github.com/d0whc3r/minecraft-servers/issues"
  },
  "author": "d0whc3r",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "test": "bats tests/bats/",
    "test:verbose": "bats --verbose tests/bats/",
    "test:quick": "bats --filter 'US1-TC00[1-6]:' tests/bats/",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "validate:all": "pnpm run lint && pnpm run test",
    "prepare": "husky",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "server:start": "./scripts/start-server.sh",
    "server:stop": "./scripts/stop-server.sh",
    "server:restart": "./scripts/restart-server.sh",
    "server:list": "./scripts/list-servers.sh",
    "server:health": "./scripts/health-check.sh --all",
    "backup": "./scripts/backup.sh",
    "backup:all": "./scripts/backup.sh --all",
    "restore": "./scripts/restore.sh",
    "dev:setup": "pnpm install && pnpm run prepare",
    "dev:clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "ci": "pnpm run lint && pnpm run test"
  },
  "keywords": [
    "minecraft",
    "server",
    "docker",
    "docker-compose",
    "testing",
    "bats",
    "bash",
    "automation",
    "modpacks",
    "game-server"
  ],
  "devDependencies": {
    "bats": "^1.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-sh"
    ]
  }
}

{
  "name": "minecraft-servers",
  "version": "1.0.0",
  "description": "Minecraft server management system with automated testing suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/d0whc3r/minecraft-servers.git"
  },
  "homepage": "https://github.com/d0whc3r/minecraft-servers#readme",
  "bugs": {
    "url": "https://github.com/d0whc3r/minecraft-servers/issues"
  },
  "author": "d0whc3r",
  "license": "ISC",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "test": "bats tests/bats/",
    "test:quick": "bats tests/bats/config-validation.bats",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "validate:all": "pnpm run lint && pnpm run test",
    "prepare": "husky",
    "server:start": "./scripts/start-server.sh",
    "server:stop": "./scripts/stop-server.sh",
    "server:restart": "./scripts/restart-server.sh",
    "server:list": "./scripts/list-servers.sh",
    "server:health": "./scripts/health-check.sh --all",
    "tui": "./scripts/tui.sh",
    "panel:start": "MCPANEL_HOST_ROOT=$PWD docker compose -f apps/web/docker-compose.yml up -d --build",
    "router:start": "./scripts/router.sh start",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh",
    "dev:clean": "rm -rf node_modules && pnpm install",
    "web:dev": "pnpm --filter @minecraft-servers/web dev",
    "web:build": "pnpm --filter @minecraft-servers/web build",
    "web:test": "pnpm --filter @minecraft-servers/web test"
  },
  "keywords": [
    "minecraft",
    "server",
    "docker",
    "docker-compose",
    "testing",
    "bats",
    "bash",
    "automation",
    "modpacks",
    "game-server"
  ],
  "devDependencies": {
    "bats": "^1.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-sh": "^0.19.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-sh"
    ]
  }
}

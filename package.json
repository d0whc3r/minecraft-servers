{
  "name": "minecraft-servers",
  "version": "1.0.0",
  "description": "Minecraft server management system with automated testing suite",
  "main": "index.js",
  "scripts": {
    "test": "./node_modules/.bin/bats tests/bats/",
    "test:verbose": "./node_modules/.bin/bats --verbose tests/bats/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:sh": "prettier --write '**/*.sh'",
    "format:md": "prettier --write '**/*.md'",
    "format:config": "prettier --write 'config/**/*.env' 'config/**/*.yml' 'config/**/*.yaml'",
    "prepare": "husky"
  },
  "keywords": [
    "minecraft",
    "server",
    "docker",
    "testing",
    "bats",
    "bash"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "bats": "^1.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0"
  }
}

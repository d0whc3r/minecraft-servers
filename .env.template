# Minecraft Multi-Server Configuration Template
# Copy this file to .env and customize for your environment

# Minecraft EULA Acceptance (required)
# By setting this to TRUE, you agree to the Minecraft End User License Agreement
# See: https://www.minecraft.net/en-us/eula
EULA=TRUE

# Docker Network Configuration
NETWORK_NAME=minecraft-network

# Base Port (servers will use sequential ports from this)
BASE_PORT=25565

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=minecraft-servers

# Git
.git/
.gitignore

# Environment files
.env*
!.env.template

# Documentation (except docs/modpacks: the panel image bakes it — the server
# registry reads modpack titles/descriptions from it in kubernetes mode)
README.md
docs/*
!docs/modpacks
.github/
.specify/

# Development files
.vscode/
.idea/
*.swp
*.tmp
*~

# Server data (mounted as volumes)
servers/
backups/

# Test files
tests/

# Logs
*.log
logs/
!apps/web/src/pages/api/logs/
!apps/web/src/pages/api/logs/**

# macOS
.DS_Store

# Temporary files
*.tmp
*.swp
*~

# Node / pnpm artifacts (workspace + panel)
node_modules/
node_modules.broken/
apps/web/dist/
apps/web/data/
apps/web/test-e2e-data/
apps/web/test-results/
apps/web/playwright-report/
.agents/

# ============================================================================
# MINECRAFT MULTI-SERVER SHARED CONFIGURATION
# ============================================================================
#
# This file contains variables shared across ALL servers.
# Server-specific configs in config/modpacks/*.env will OVERRIDE these values.
#
# Load order: .env (this file) → config/modpacks/<server>.env (overrides)
#

# ============================================================================
# EULA - REQUIRED
# ============================================================================
# By setting this to TRUE, you accept the Minecraft EULA
# https://account.mojang.com/documents/minecraft_eula
EULA=TRUE

# ============================================================================
# CURSEFORGE API (for modpack downloads)
# ============================================================================
# CurseForge API Key (required for AUTO_CURSEFORGE modpacks)
CF_API_KEY='$2a$10$xxx'

# ============================================================================
# RCON (Remote Console) - Shared Configuration
# ============================================================================
# Enable RCON for remote management (can be overridden per server)
ENABLE_RCON=true

# RCON Password - CHANGE THIS to a secure password in production
# This is shared across all servers by default
RCON_PASSWORD=minecraft

# RCON Port default (each server config overrides this with a unique port in
# the managed range 26565-26664). Published bound to 127.0.0.1 only
RCON_PORT=25575

# Do not broadcast RCON commands to ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# MC-ROUTER - Hostname-based routing (docker-compose.router.yml)
# ============================================================================
# ALL game traffic goes through mc-router: players connect once to
# MC_ROUTER_PORT and the hostname picks the server. There are no per-server
# game ports and no direct IP:port access. Manage the router with:
#   ./scripts/router.sh start|stop|restart|status|routes|logs

# Domain suffix for routes: players connect to <server>.<MC_ROUTER_DOMAIN>.
# RECOMMENDED when you don't have your own domain: nip.io (free wildcard DNS
# that maps <anything>.<ip>.nip.io to <ip>), so LAN/remote players need zero
# DNS or hosts-file setup:
#   MC_ROUTER_DOMAIN=192.168.1.10.nip.io  ->  vanilla.192.168.1.10.nip.io
# With your own domain, point a wildcard record (*.mc.example.com) at this
# host instead. See docs/ROUTER.md.
MC_ROUTER_DOMAIN=mc.local

# Public port of the router itself - the single port everyone connects to
MC_ROUTER_PORT=25565

# Router REST API, published on 127.0.0.1 only (used by ./scripts/router.sh routes)
MC_ROUTER_API_PORT=8080

# Docker group ID with read access to /var/run/docker.sock
# (find yours with: getent group docker | cut -d: -f3; on Docker Desktop use 0;
# with rootless podman the socket is owned by your own user: use 0)
MC_ROUTER_DOCKER_GID=999

# Container socket path on the HOST mounted read-only into mc-router (service
# discovery) and the web panel. Leave unset for Docker (/var/run/docker.sock);
# with rootless podman set it to your podman socket:
#   DOCKER_SOCKET=/run/user/$(id -u)/podman/podman.sock
#DOCKER_SOCKET=/run/user/1000/podman/podman.sock

# User:group the mc-router container runs as. Leave unset for Docker (image
# default, a non-root user). With rootless podman set 0:0 - inside a rootless
# container uid 0 maps to your own host user, which owns the podman socket.
#MC_ROUTER_USER=0:0

# ============================================================================
# SHARED DEFAULTS (can be overridden per server)
# ============================================================================

# Timezone
TZ=UTC

# Enable rolling logs to prevent log files from growing too large
ENABLE_ROLLING_LOGS=true

# Use Aikar's optimized JVM flags (recommended for servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Online mode - require Mojang authentication
# Set to false for offline/cracked servers (override per server if needed)
ONLINE_MODE=false

# Allow flight (useful for modpacks with flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# KUBERNETES (optional)
# ============================================================================
# ./scripts/k8s-install.sh reads this file and turns it into chart values:
# the keys above (EULA, CF_API_KEY, RCON_PASSWORD, MC_ROUTER_DOMAIN/PORT, TZ,
# and everything else here) become the servers' shared configuration in the
# cluster. Docker-only settings (MC_ROUTER_DOCKER_GID, ...) are ignored there.

# Type of the router Service: LoadBalancer | NodePort | ClusterIP
# (default: LoadBalancer; kind clusters get NodePort automatically - they
# have no LB controller and the Service would stay <pending> forever)
# MC_ROUTER_SERVICE_TYPE=LoadBalancer

# Fixed router nodePort; kind-config.yaml forwards host 25565 to it.
# Keep in sync when changing the kind config (default: 30065)
# MC_ROUTER_NODE_PORT=30065

# Ingress host for the web panel (empty = port-forward only)
# K8S_PANEL_HOST=panel.mc.example.com

# Ingress class used by the panel Ingress (default: contour)
# K8S_PANEL_INGRESS_CLASS=contour

# ============================================================================
# NOTES
# ============================================================================
# - Server-specific settings in config/modpacks/*.env OVERRIDE these values
# - Keep sensitive values (passwords, API keys) in this file
# - Add this file to .gitignore in production environments
# - Each server config only needs to define TYPE, VERSION, RCON_PORT, etc.

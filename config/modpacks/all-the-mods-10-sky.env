# All The Mods 10: To the Sky Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/all-the-mods-10-sky
# Skyblock-flavored variant of ATM10 with 300+ mods for 1.21.1

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/all-the-mods-10-sky

# Minecraft Version - ATM10 Sky uses 1.21.1
VERSION=1.21.1

# Memory Allocation - ATM series needs 8GB+ for smooth operation
MEMORY=8G

# External Port (MUST be unique)
SERVER_PORT=25585

# Server Display Name
SERVER_NAME=all-the-mods-10-sky

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (kitchen-sink modpack supports large communities)
MAX_PLAYERS=50

# Game Difficulty (normal recommended for balanced progression)
DIFFICULTY=normal

# Game Mode (survival for the full progression)
MODE=survival

# Enable PVP
PVP=true

# View Distance (10-12 recommended; skyblock worlds are lighter)
VIEW_DISTANCE=12

# Simulation Distance
SIMULATION_DISTANCE=10

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (essential for big kitchen-sink modpacks)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=26585

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type (the modpack provides its own skyblock world type)
LEVEL_TYPE=minecraft:default

# Generate Structures
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6ATM10: To the Sky§r - Kitchen sink in the sky!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Force synchronize (re-evaluate modpack on restart)
# CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
# CF_SKIP_UPDATE_CHECK=false

# Exclude client-side mods that shouldn't run on server (same family as ATM10)
CF_EXCLUDE_MODS="crash-assistant,melody,kubejs-tweaks"

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable (can save resources for large servers)
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=1800
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - ATM10: To the Sky is the skyblock variant of All The Mods 10 (3M+ downloads)
# - Full kitchen-sink progression starting from a floating island
# - Requires CF_API_KEY in the shared .env for first download
# - First startup will take longer as it downloads the massive modpack
# - Check logs with: docker logs -f mc-all-the-mods-10-sky
# - Recommended minimum: 8GB RAM, 20GB disk space
# - Players need the same modpack version to connect
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

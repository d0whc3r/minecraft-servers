# FTB StoneBlock 4 Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/ftb-stoneblock-4
# The classic "island in a cave" skyblock-style kitchen sink, now on NeoForge 1.21.1.
# Community pick as one of the best modpacks of 2025 (r/feedthebeast).

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download (NeoForge-based modpack)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/ftb-stoneblock-4

# Minecraft Version - SB4 targets NeoForge 1.21.1
VERSION=1.21.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.21.1 requires Java 21 (latest image tag now ships Java 25)
JAVA_VERSION=java21

# Memory Allocation - Kitchen-sink pack, 8GB+ for smooth operation
MEMORY=8G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=stoneblock4

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26586

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type - keep default: the pack builds its underground island world via
# its own world-gen datapack; changing level-type breaks progression
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§bFTB StoneBlock 4§r - Dig in! Everything starts from one stone"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the latest release file. Installed: FTB StoneBlock 4 1.20.1 (Sep 1, 2026)
# - FTB names files after the pack build, not the MC version; this build targets
#   NeoForge 1.21.1
# - remove/update CF_FILE_ID to move to a newer release
CF_SLUG=ftb-stoneblock-4
CF_FILE_ID=8788623

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - FTB StoneBlock 4 is a NeoForge 1.21.1 kitchen-sink skyblock in a cave world
# - Quest-guided progression (FTB Quests) with tech, magic and exploration
# - One of r/feedthebeast's top-rated packs of 2025, actively updated
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-stoneblock4
# - Recommended minimum: 8GB RAM, 15GB disk space
# - Players need the same modpack version to connect

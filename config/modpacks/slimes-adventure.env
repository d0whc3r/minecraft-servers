# Slimes Adventure Modpack Configuration
# Modrinth: https://modrinth.com/modpack/slimes-adventure
# A fun adventure modpack focused on exploration and discovery

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth modpack loader
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=slimes-adventure

# Minecraft Version - REQUIRED for proper modpack version resolution
# Slimes Adventure supports 1.16.5 and 1.19.2 - using latest
VERSION=1.19.2

# Memory Allocation - Adventure modpacks typically need 4-6GB
MEMORY=4G

# External Port (MUST be unique)
SERVER_PORT=25569

# Server Display Name
SERVER_NAME=slimes-adventure

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight
ALLOW_FLIGHT=false

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=4G

# Max Memory
MAX_MEMORY=4G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=26569

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Modrinth Version Type (release, beta, or alpha)
# Leave unset to auto-select latest stable
# MODRINTH_MODPACK_VERSION_TYPE=release

# Modrinth Loader (auto-detected, but can specify: fabric, forge, quilt)
# MODRINTH_LOADER=fabric
MODRINTH_LOADER=forge

# Exclude client-side mods that shouldn't run on server
# legendarytooltips requires prism-lib which is Fabric-only (not compatible with Forge)
# Use partial filename matching (case-insensitive)
MODRINTH_EXCLUDE_FILES="notenoughanimations,oculus,embeddium,embeddiumplus,lambdynamiclights,yungsmenutweaks,entity_model_features,entity_texture_features,3dskinlayers"

# Exclude from overrides directory as well
MODRINTH_OVERRIDES_EXCLUSIONS="mods/*legendarytooltips*.jar,mods/*LegendaryTooltips*.jar"

# Force include specific mods
# MODRINTH_FORCE_INCLUDE_FILES: |
#   servermod1

# Force synchronize (re-evaluate includes/excludes on restart)
# Disabled: allows manual removal of incompatible mods to persist
# MODRINTH_FORCE_SYNCHRONIZE="true"

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§aSlimes Adventure§r - Explore and Discover!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=30

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Slimes Adventure is an adventure-focused modpack
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-slimes-adventure
# - Recommended minimum: 4GB RAM, 8GB disk space
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

# Plants vs. Zombies+ Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/plants-vs-zombies
# A Vanilla+ modpack inspired by Plants vs Zombies - build defenses with plants,
# survive stronger zombie waves, and explore an immersive world.

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Java Version - MC 26.1.2 requires Java 25+ (class version 69.0)
JAVA_VERSION=java25

# Server Type - CurseForge auto-download (Fabric-based modpack)
TYPE=AUTO_CURSEFORGE

# Minecraft Version (auto-detected from modpack manifest for AUTO_CURSEFORGE)
# VERSION refers to the MINECRAFT version, not the modpack version.
# Modpack 3.x targets MC 26.1.2
VERSION=26.1.2

# Memory Allocation - Vanilla+ modpack, 4-6GB recommended
MEMORY=4G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=plants-vs-zombies

# ============================================================================
# MODPACK SETTINGS
# ============================================================================

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/plants-vs-zombies

# Modpack version pin (independent of the Minecraft VERSION above)
# 3.2.0 - "Plants vs. Zombies - MC 26.1.2 - 3.2.0.zip" (released 2026-08-22)
# https://www.curseforge.com/minecraft/modpacks/plants-vs-zombies/files/8708490
CF_SLUG=plants-vs-zombies
CF_FILE_ID=8708490

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# Hardcore Mode
HARDCORE=false

# Force Gamemode
FORCE_GAMEMODE=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# View Distance (chunks, recommended: 8-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=10

# Generate Structures
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Protection (0 to disable)
SPAWN_PROTECTION=0

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication - set false for offline/LAN)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (allows flight mods in survival)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=4G

# Max Memory
MAX_MEMORY=4G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26579

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD GENERATION
# ============================================================================

# Level Type
LEVEL_TYPE=minecraft:default

# World Seed (leave empty for random)
# SEED=

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§aPlants vs. Zombies+§r - Build Defenses, Survive the Horde!"

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=true

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=30

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Plants vs. Zombies+ is a Fabric-based Vanilla+ modpack
# - First startup will take longer as it downloads and installs 174+ dependencies
# - Check logs with: docker logs -f mc-plants-vs-zombies
# - Recommended minimum: 4GB RAM, 8GB disk space
# - Modpack version 3.2.0, file ID 8708490 (released Aug 22, 2026); MC 26.1.2 / Fabric
# - Installed: 3.0.0 (Jul 25, 2026) - remove/update CF_FILE_ID to move to a newer release
# - For full options: https://docker-minecraft-server.readthedocs.io/en/latest/variables/

# Menagerie Configuration
# Full documentation: https://docker-minecraft-server.readthedocs.io/en/latest/variables/

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type (VANILLA, FORGE, FABRIC, PAPER, SPIGOT, BUKKIT, AUTO_CURSEFORGE, MODRINTH, etc.)
TYPE=AUTO_CURSEFORGE

# Minecraft Version - Menagerie 2.4 (latest, 2025-10-20) targets MC 1.20.1
# Auto-detected from the modpack manifest, pinned here to satisfy validate-config
VERSION=1.20.1

# Memory Allocation (e.g., 2G, 4G, 8G, 16G)
MEMORY=6G

# External Port (MUST be unique per server)
SERVER_PORT=25577

# Server Display Name (shown in server list)
SERVER_NAME=menagerie

# ============================================================================
# MODPACK SETTINGS (if TYPE=AUTO_CURSEFORGE or MODRINTH)
# ============================================================================

# CurseForge Modpack URL (required if TYPE=AUTO_CURSEFORGE)
# Example: https://www.curseforge.com/minecraft/modpacks/all-the-mods-8
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/menagerie

# Exclude specific mods from the modpack (comma or space delimited list of project slugs or IDs)
CF_EXCLUDE_MODS=fog,bountiful-critters

# Modrinth Modpack Slug or Project ID (if TYPE=MODRINTH)
# Example: cobbleverse, slimes-adventure
# CRITICAL: For Modrinth modpacks, you MUST also set VERSION above to match
#           the Minecraft version used by the modpack
# Check modpack page or use: curl -s "https://api.modrinth.com/v2/project/SLUG" | grep game_versions
# MODRINTH_MODPACK=

# Optional: Specify exact modpack version/release (by version number or ID)
# Leave unset to use latest compatible with VERSION above
# MODRINTH_VERSION=

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP (true/false)
PVP=true

# Hardcore Mode (true/false)
HARDCORE=false

# Force Gamemode (force players to join in default mode)
FORCE_GAMEMODE=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# World Seed (leave empty for random)
# SEED=

# Level Type (minecraft:default, minecraft:flat, minecraft:large_biomes, minecraft:amplified)
LEVEL_TYPE=minecraft:default

# View Distance (chunks, recommended: 8-12)
VIEW_DISTANCE=10

# Simulation Distance (chunks, default: 10)
# SIMULATION_DISTANCE=10

# Max World Size (blocks, radius)
# MAX_WORLD_SIZE=

# Max Build Height (default: 256)
# MAX_BUILD_HEIGHT=256

# ============================================================================
# WORLD GENERATION
# ============================================================================

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Protection (0 to disable)
# SPAWN_PROTECTION=16

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication - set false for offline/LAN)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Whitelist (comma-separated usernames/UUIDs)
# WHITELIST=

# Allow Flight (allows flight mods in survival)
ALLOW_FLIGHT=false

# Prevent Proxy Connections
# PREVENT_PROXY_CONNECTIONS=false

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Use MeowIce Flags (optimized for Java 17+)
# USE_MEOWICE_FLAGS=false

# Use GraalVM (requires GraalVM image)
# USE_MEOWICE_GRAALVM_FLAGS=false

# Initial Memory (if different from MEMORY)
# INIT_MEMORY=1G

# Max Memory (if different from MEMORY)
# MAX_MEMORY=

# Custom JVM Options
# JVM_OPTS=
# JVM_XX_OPTS=

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=26577

# RCON Password (auto-generated if not set)
# RCON_PASSWORD=

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# AUTOPAUSE/AUTOSTOP (Resource Optimization)
# ============================================================================

# Auto-pause server when no players are online
# ENABLE_AUTOPAUSE=false
# AUTOPAUSE_TIMEOUT_EST=3600

# Auto-stop server when no players connect
# ENABLE_AUTOSTOP=false
# AUTOSTOP_TIMEOUT_EST=3600
# AUTOSTOP_TIMEOUT_INIT=1800

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
# MOTD="A Minecraft Server"

# Server Icon URL
# ICON=

# Enable Command Blocks
# ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
# PLAYER_IDLE_TIMEOUT=0

# Network Compression Threshold
# NETWORK_COMPRESSION_THRESHOLD=256

# Enable Rolling Logs
# ENABLE_ROLLING_LOGS=false

# Timezone
# TZ=UTC

# Resource Pack URL
# RESOURCE_PACK=
# RESOURCE_PACK_SHA1=
# RESOURCE_PACK_ENFORCE=false

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Snooper Enabled (anonymous stats to Mojang)
SNOOPER_ENABLED=true

# Enable Status (server list ping)
# ENABLE_STATUS=true

# Sync Chunk Writes
# SYNC_CHUNK_WRITES=true

# Use Native Transport
# USE_NATIVE_TRANSPORT=true

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log Timestamp
# LOG_TIMESTAMP=false

# Enable JMX Monitoring
# ENABLE_JMX=false
# JMX_HOST=

# Debug Output
# DEBUG=false
# DEBUG_AUTOPAUSE=false
# DEBUG_AUTOSTOP=false

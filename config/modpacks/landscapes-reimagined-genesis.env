# Landscapes Reimagined Genesis 3.2 [Finale]
# https://modrinth.com/modpack/landscapes-reimagined-genesis

# Official mrpack manifest: Minecraft 1.20.1 and Fabric Loader 0.16.0.
TYPE=MODRINTH
MODRINTH_MODPACK=landscapes-reimagined-genesis
MODRINTH_VERSION=pBrfi38A
MODRINTH_LOADER=fabric
VERSION=1.20.1
JAVA_VERSION=java17
SERVER_NAME=landscapes-reimagined-genesis

# Initial estimate for a pack with 267 server-compatible indexed files.
MEMORY=8G

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
PVP=true
ALLOW_FLIGHT=true

# Terralith, Regions Unexplored and the bundled datapacks drive worldgen from
# the normal world type; no separate preset is declared by the pack.
LEVEL=world
LEVEL_TYPE=minecraft:default
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
GENERATE_STRUCTURES=true
ALLOW_NETHER=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26595
BROADCAST_RCON_TO_OPS=false

ENABLE_ROLLING_LOGS=true

# The Pixelmon Modpack Server Configuration
# Modrinth: https://modrinth.com/modpack/the-pixelmon-modpack
# CurseForge: https://www.curseforge.com/minecraft/modpacks/the-pixelmon-modpack
# The classic Pokemon mod for Minecraft - catch, train and battle

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth auto-download
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=the-pixelmon-modpack

# Minecraft Version - REQUIRED for proper modpack version resolution
# Latest Pixelmon generation uses Minecraft 1.21.1 (NeoForge)
VERSION=1.21.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.21.1 requires Java 21 (latest image tag now ships Java 25)
JAVA_VERSION=java21

# Memory Allocation - Pixelmon servers need 6GB+ for smooth operation
MEMORY=6G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=pixelmon

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful avoids hostile mob interference with Pokemon)
DIFFICULTY=normal

# Game Mode (survival for the full Pokemon journey)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (some Pokemon and items provide flight)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26582

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (Pokemon centers, gyms and shrines)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers and Pixelmon NPCs)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Pixelmon§r - Gotta catch 'em all in Minecraft!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - The Pixelmon Modpack is the classic Pokemon mod (20M+ downloads)
# - Includes Pixelmon, gameshark-like tools, gym commands and Pokemon NPCs
# - Latest generation runs on Minecraft 1.21.1 with NeoForge
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-pixelmon
# - Recommended minimum: 6GB RAM, 15GB disk space
# - Players need the same modpack version to connect
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

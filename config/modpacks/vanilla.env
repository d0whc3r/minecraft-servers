# Vanilla Minecraft Server Configuration (Paper 26.2)
# Full documentation: https://docker-minecraft-server.readthedocs.io/en/latest/variables/

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Paper for optimized vanilla experience
TYPE=PAPER

# Minecraft Version - latest stable release (Mojang + Paper in sync)
VERSION=26.2

# Memory Allocation
MEMORY=2G

# Server Display Name
SERVER_NAME=vanilla

# External Port (MUST be unique)
SERVER_PORT=25567

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks)
VIEW_DISTANCE=10

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# ============================================================================
# ADDITIONAL OPTIONS (uncomment to use)
# ============================================================================

# Performance optimization with Aikar's flags
# USE_AIKAR_FLAGS=true

# Whitelist
# ENABLE_WHITELIST=false
# WHITELIST=player1,player2

# RCON
ENABLE_RCON=true
RCON_PORT=26567

# World settings
LEVEL=world
GENERATE_STRUCTURES=true
ALLOW_NETHER=true
SPAWN_ANIMALS=true
SPAWN_MONSTERS=true
SPAWN_NPCS=true

# Autopause (pause server when no players online)
# ENABLE_AUTOPAUSE=false
# AUTOPAUSE_TIMEOUT_EST=3600

# For full list of options, see:
# https://docker-minecraft-server.readthedocs.io/en/latest/variables/

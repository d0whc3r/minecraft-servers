# Vanilla Minecraft Server Configuration (Paper 1.20.4)

# Server Type - Paper for optimized vanilla experience
TYPE=PAPER

# Minecraft Version
VERSION=1.20.4

# Memory Allocation
MEMORY=2G

# Server Display Name
SERVER_NAME=Vanilla Server

# External Port
SERVER_PORT=25569

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure)
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance (chunks)
VIEW_DISTANCE=10

# Online Mode (require Mojang authentication)
ONLINE_MODE=true

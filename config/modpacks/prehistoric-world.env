# Prehistoric World 49.4.0
# https://modrinth.com/modpack/prehistoric-world-modpack

# The official mrpack manifest pins Minecraft 1.20.1 and Forge 47.4.20.
TYPE=MODRINTH
MODRINTH_MODPACK=prehistoric-world-modpack
MODRINTH_VERSION=7TUCziQD
MODRINTH_LOADER=forge
VERSION=1.20.1
JAVA_VERSION=java17
SERVER_NAME=prehistoric-world

# The author recommends at least 7GB for a server; use a whole-GiB allocation
# above that minimum and tune it after observing real usage.
MEMORY=8G

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
PVP=true
ALLOW_FLIGHT=true

# The mrpack includes configs, mods, resource packs, and shaders, but no world
# or server.properties override. Its mods handle world generation from the
# normal world type.
LEVEL=world
LEVEL_TYPE=minecraft:default
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
GENERATE_STRUCTURES=true
ALLOW_NETHER=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26598
BROADCAST_RCON_TO_OPS=false

USE_AIKAR_FLAGS=true
ENABLE_ROLLING_LOGS=true

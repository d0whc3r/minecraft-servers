# Homestead - A Cozy Survival Experience Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/homestead-cozy
# Hand-crafted cozy survival: quests, farming, building and exploration (2.5M+ downloads)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download (Forge-based modpack)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/homestead-cozy

# Minecraft Version - Homestead uses Minecraft 1.20.1 (Forge)
VERSION=1.20.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.20.1 requires Java 17 (latest image tag now ships Java 25)
JAVA_VERSION=java17

# Memory Allocation - Medium modpack, 6GB for smooth co-op play
MEMORY=6G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=homestead

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty - cozy pack: keep normal (drop to easy for a calmer server)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP - cozy co-op focus: leave PVP off
PVP=false

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26590

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§aHomestead§r - A cozy survival experience"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=30

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the latest release file. Installed: Homestead 1.3.7
# - remove/update CF_FILE_ID to move to a newer release
CF_SLUG=homestead-cozy
CF_FILE_ID=8110152

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Homestead is a Forge 1.20.1 cozy survival pack: hand-crafted world, quests,
#   farming, seasons, furniture and light RPG touches
# - Trending pick in 2025/2026 "cozy/chill modpack" guides (2.5M+ downloads)
# - Note: the Modrinth "Homestead" (homestead) is a different Fabric variant;
#   this config tracks the CurseForge Forge build (homestead-cozy)
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-homestead
# - Recommended minimum: 6GB RAM, 12GB disk space

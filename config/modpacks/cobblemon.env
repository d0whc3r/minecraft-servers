# Cobblemon Official Modpack [Fabric] Server Configuration
# Modrinth: https://modrinth.com/modpack/cobblemon-fabric
# The official Cobblemon modpack: Pokémon in Minecraft, minimal extras (10M+ downloads)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth auto-download
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=cobblemon-fabric

# Minecraft Version - REQUIRED for proper modpack version resolution
# Cobblemon Official Modpack supports 1.20.1 and 1.21.1; using latest (1.21.1)
VERSION=1.21.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.21.1 requires Java 21 (latest image tag now ships Java 25)
JAVA_VERSION=java21

# Memory Allocation - Cobblemon is lightweight; 6GB gives headroom for 20 players
MEMORY=6G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=cobblemon

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP - Pokémon battles are player-driven; keep world PVP off
PVP=false

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (Legendary Pokémon mounts can count as flight)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26592

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§9Cobblemon§r - Official modpack - Catch 'em all in Minecraft!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks (useful for custom gym/tournament events)
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=30

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Optional: pin a specific modpack release (version number or ID)
# Leave unset to always install the latest release compatible with VERSION
# MODRINTH_VERSION=

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Cobblemon is the open-source Pokémon mod for Minecraft; this is its
#   official Fabric pack (Cobblemon + performance mods, no heavy extras)
# - Complements cobbleverse (already configured here), which is the
#   adventure/structure-heavy Cobblemon spin-off; this one is the vanilla-ish
#   official experience
# - Spawn rates and species are configured server-side via Cobblemon's configs
#   under servers/cobblemon/data/config/cobblemon/
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-cobblemon
# - Recommended minimum: 6GB RAM, 10GB disk space
# - Players can join with just the modpack's Fabric version installed

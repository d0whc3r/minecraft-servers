# Cursed Walking Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/cursed-walking-a-modern-zombie-apocalypse
# The Walking Dead style zombie survival modpack with slow, deadly hordes

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/cursed-walking-a-modern-zombie-apocalypse

# Minecraft Version - Cursed Walking uses 1.20.1 (Forge)
VERSION=1.20.1

# Memory Allocation - Large modpack with dense hordes needs 8GB
MEMORY=8G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=cursed-walking

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (hard is the intended survival experience)
DIFFICULTY=hard

# Game Mode (survival)
MODE=survival

# Enable PVP
PVP=true

# View Distance (10 is a good balance for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (no legit flight in this pack; keep true to avoid kicks from mod edge cases)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26584

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (abandoned towns and loot locations)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters (the whole point)
SPAWN_MONSTERS=true

# Spawn NPCs
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§2Cursed Walking§r - The dead walk. Survive together."

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Shader mods are client-only but not flagged as such in this pack's manifest;
# keeping colorwheel without oculus crashes the server at mod loading
CF_EXCLUDE_MODS="oculus,colorwheel"

# Force synchronize (re-evaluate modpack on restart)
# CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
# CF_SKIP_UPDATE_CHECK=false

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=1800
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Cursed Walking is a Walking Dead inspired zombie survival pack (8M+ downloads)
# - Slow but deadly zombie hordes, scarce loot, teamwork-oriented survival
# - Requires CF_API_KEY in the shared .env for first download
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-cursed-walking
# - Recommended minimum: 8GB RAM, 20GB disk space
# - Players need the same modpack version to connect
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

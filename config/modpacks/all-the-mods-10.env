# All The Mods 10 Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/all-the-mods-10
# Massive kitchen sink modpack with 400+ mods for ultimate Minecraft experience

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/all-the-mods-10

# Pinned modpack version — locks to a specific release so it does NOT auto-update.
# Current: All the Mods 10-7.0 (v7.0). To change: grab the file ID from the CurseForge
# Files tab (the number in .../files/NNNNNNN). Delete CF_FILE_ID to track latest again.
CF_FILE_ID=8091114

# Minecraft Version - ATM10 uses latest 1.21.1
VERSION=1.21.1

# Memory Allocation - Massive modpack needs 8GB+ for smooth operation
MEMORY=8G

# External Port (MUST be unique - check other servers)
SERVER_PORT=25578

# Server Display Name
# IMPORTANT: This is used for the Docker container name - NO SPACES, lowercase only!
# Docker container will be named: mc-{SERVER_NAME}
SERVER_NAME=all-the-mods-10

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (massive modpack supports large communities)
MAX_PLAYERS=50

# Game Difficulty (normal recommended for balanced progression)
DIFFICULTY=normal

# Game Mode (survival for ultimate modded experience)
MODE=survival

# Enable PVP (essential for large modded communities)
PVP=true

# View Distance (12-14 recommended for exploration in modded worlds)
VIEW_DISTANCE=12

# Simulation Distance
SIMULATION_DISTANCE=10

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (recommended for controlled access to large modded servers)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (essential for massive modpacks with 400+ mods)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port (unique per server)
RCON_PORT=26578

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6All The Mods 10§r - Ultimate Modded Experience!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Force synchronize (re-evaluate modpack on restart)
# CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
# CF_SKIP_UPDATE_CHECK=false

# Exclude client-side mods that shouldn't run on server
CF_EXCLUDE_MODS="crash-assistant,melody,kubejs-tweaks,occultism-kubejs,theurgy-kubejs,ponderjs"

CF_OVERRIDES_EXCLUSIONS="mods/ponder*.jar,mods/*kubejs*.jar,mods/*Ponder*.jar"

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable (can save resources for large servers)
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=1800
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - All The Mods 10 is the ultimate kitchen sink modpack with 400+ mods
# - Features all major modpacks: Tech (Mekanism, Thermal), Magic (Botania, Blood Magic), Exploration, and more
# - First startup will take longer as it downloads the massive modpack
# - Check logs with: docker logs -f mc-all-the-mods-10
# - Recommended minimum: 8GB RAM, 20GB disk space
# - Players need the same modpack version to connect
# - Consider enabling whitelist for controlled access to ultimate modded server
# - IMPORTANT: SERVER_NAME is used for Docker container name - must be lowercase, no spaces!
# - Docker container name will be: mc-{SERVER_NAME}
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

# Prominence II RPG Server Configuration

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.20.1

# Memory Allocation
MEMORY=6G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/prominence-2-rpg

# Server Display Name
SERVER_NAME=Prominence II RPG

# External Port
SERVER_PORT=25567

# Maximum Players
MAX_PLAYERS=15

# Game Difficulty
DIFFICULTY=normal

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance
VIEW_DISTANCE=8

# Online Mode
ONLINE_MODE=true

# Aged 3.1.2
# https://modrinth.com/modpack/aged

# Official mrpack manifest: Minecraft 1.20.1 and Fabric Loader 0.16.9.
TYPE=MODRINTH
MODRINTH_MODPACK=aged
MODRINTH_VERSION=7BgHWBWr
MODRINTH_LOADER=fabric
VERSION=1.20.1
JAVA_VERSION=java17
SERVER_NAME=aged

# Initial estimate for this large pack; tune after observing real usage.
MEMORY=6G

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
PVP=true
ALLOW_FLIGHT=true

# Aged ships its Paxi datapacks and configs as mrpack overrides. No custom
# server.properties world preset is required by the author.
LEVEL=world
LEVEL_TYPE=minecraft:default
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
GENERATE_STRUCTURES=true
ALLOW_NETHER=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26594
BROADCAST_RCON_TO_OPS=false

ENABLE_ROLLING_LOGS=true

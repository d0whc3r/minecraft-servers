# RLCraft Server Configuration

JAVA_VERSION=java8
# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.12.2

# Memory Allocation
MEMORY=6G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/rlcraft

# Pinned modpack version — locks to a specific release so it does NOT auto-update.
# Current: RLCraft 1.12.2 - Release v2.9.3 (v2.9.3). To change: grab the file ID from the
# CurseForge Files tab (the number in .../files/NNNNNNN). Delete CF_FILE_ID to track latest.
CF_FILE_ID=4612979

# Server Display Name
SERVER_NAME=rlcraft

# External Port
SERVER_PORT=25566

# Maximum Players
MAX_PLAYERS=15

# Game Difficulty (RLCraft is hard by design)
DIFFICULTY=hard

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance
VIEW_DISTANCE=8

# Online Mode
ONLINE_MODE=false

# RCON
ENABLE_RCON=true
RCON_PORT=26566

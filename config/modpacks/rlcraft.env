# RLCraft Server Configuration

JAVA_VERSION=java8
# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.12.2

# Memory Allocation
MEMORY=6G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/rlcraft

# Server Display Name
SERVER_NAME=rlcraft

# External Port
SERVER_PORT=25568

# Maximum Players
MAX_PLAYERS=15

# Game Difficulty (RLCraft is hard by design)
DIFFICULTY=hard

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance
VIEW_DISTANCE=8

# Online Mode
ONLINE_MODE=false

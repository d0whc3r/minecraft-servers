# Better MC [FORGE] BMC4 Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/better-mc-forge-bmc4
# Enhanced vanilla+ modpack with new biomes, structures, tech and magic

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download (the CF build is newer than Modrinth's
# v59, whose overrides break dedicated-server mod resolution)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/better-mc-forge-bmc4

# Minecraft Version - REQUIRED for proper modpack version resolution
# BMC4 uses Minecraft 1.20.1 (Forge)
VERSION=1.20.1

# Memory Allocation - Enhanced vanilla+ needs 6GB+ for smooth operation
MEMORY=6G

# External Port (MUST be unique)
SERVER_PORT=25580

# Server Display Name
SERVER_NAME=better-mc-bmc4

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=26580

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Better MC BMC4§r - Vanilla, but so much better!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the latest release file. Installed: BMC4 [FORGE] 1.20.1 v61
# - remove/update CF_FILE_ID to move to a newer release
CF_SLUG=better-mc-forge-bmc4
CF_FILE_ID=8689205

# The pack ships the client-only missingmodschecker mod as an overrides/mods
# file; it opens a Swing window on startup and crashes headless servers
# (java.awt.HeadlessException). Exclude it from the overrides copy.
CF_OVERRIDES_EXCLUSIONS="mods/missingmodschecker*.jar"

# Shader mods: oculus is flagged client-only (skipped on servers) but colorwheel
# is not, and it hard-depends on oculus - exclude both or mod loading fails
CF_EXCLUDE_MODS="oculus,colorwheel"

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Better MC BMC4 is a Forge-based enhanced vanilla+ modpack for 1.20.1
# - Adds new biomes, structures, dungeons, tech (Create, Mekanism) and magic
# - One of the most downloaded modpacks (18M+ on CurseForge)
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-better-mc-bmc4
# - Recommended minimum: 6GB RAM, 15GB disk space
# - Players need the same modpack version to connect
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

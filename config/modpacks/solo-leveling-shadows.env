# Solo Leveling - Shadows Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/solo-leveling-shadows
# Advanced Solo Leveling modpack with 400+ mods, gates system, and hunter progression

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Java runtime pin — itzg ':latest' is now Java 25; this pack needs Java 17 (Forge/MC 1.20.1).
JAVA_VERSION=java17

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/solo-leveling-shadows

# Pinned modpack version — locks to a specific release so it does NOT auto-update.
# Current: SLS-1.1.3 (v1.1.3). To change: grab the file ID from the CurseForge
# Files tab (the number in .../files/NNNNNNN). Delete CF_FILE_ID to track latest again.
CF_FILE_ID=7784343

# Minecraft Version - From modpack info
VERSION=1.20.1

# Memory Allocation - Large modpack with 400+ mods needs 6-8GB
MEMORY=6G

# External Port (MUST be unique - check other servers)
SERVER_PORT=25574

# Server Display Name
# IMPORTANT: This is used for the Docker container name - NO SPACES, lowercase only!
# Docker container will be named: mc-{SERVER_NAME}
SERVER_NAME=solo-leveling-shadows

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (large modpack supports more players)
MAX_PLAYERS=30

# Game Difficulty (normal recommended for balanced progression)
DIFFICULTY=normal

# Game Mode (survival for RPG progression)
MODE=survival

# Enable PVP (essential for hunter vs hunter combat)
PVP=true

# View Distance (12-16 recommended for exploration and gates)
VIEW_DISTANCE=14

# Simulation Distance
SIMULATION_DISTANCE=12

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (recommended for large RPG servers)
ENABLE_WHITELIST=false

# Allow Flight (hunters can fly in this modpack)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (essential for large modpacks)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port (unique per server)
RCON_PORT=26574

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Solo Leveling: Shadows§r - Rise to Power!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Force synchronize (re-evaluate modpack on restart)
CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
CF_SKIP_UPDATE_CHECK=false

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable (can save resources for large modpacks)
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=600  # 10 minutes for large modpacks
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Solo Leveling: Shadows is an advanced RPG modpack with 400+ mods
# - Features gates system (E-S rank), hunter classes, and extensive questing
# - First startup will take longer as it downloads the large modpack
# - Check logs with: docker logs -f mc-solo-leveling-shadows
# - Recommended minimum: 6GB RAM, 12GB disk space
# - Players need the same modpack version to connect
# - Consider enabling whitelist for controlled access to large RPG server
# - IMPORTANT: SERVER_NAME is used for Docker container name - must be lowercase, no spaces!
# - Docker container name will be: mc-{SERVER_NAME}
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

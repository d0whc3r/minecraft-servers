# Cobbleverse Modpack Configuration
# Modrinth: https://modrinth.com/modpack/cobbleverse
# A Pokemon-themed modpack featuring Cobblemon with adventure and exploration

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth modpack loader
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=cobbleverse

# Minecraft Version - REQUIRED for proper modpack version resolution
# Cobbleverse uses Minecraft 1.21.1
VERSION=1.21.1

# Memory Allocation - Cobblemon modpacks typically need 6-8GB
MEMORY=6G

# External Port (MUST be unique)
SERVER_PORT=25568

# Server Display Name
SERVER_NAME=cobbleverse

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (useful for Pokemon that can fly)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=25575

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Modrinth Version Type (release, beta, or alpha)
# Leave unset to auto-select latest stable
# MODRINTH_MODPACK_VERSION_TYPE=release

# Modrinth Loader (auto-detected, but can specify: fabric, forge, quilt)
# MODRINTH_LOADER=fabric

# Exclude client-side mods that shouldn't run on server
# Uncomment and add mods if needed
# MODRINTH_EXCLUDE_FILES: |
#   clientmod1
#   clientmod2

# Force include specific mods
# MODRINTH_FORCE_INCLUDE_FILES: |
#   servermod1

# Force synchronize (re-evaluate includes/excludes on restart)
# MODRINTH_FORCE_SYNCHRONIZE=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Cobbleverse§r - Catch 'em all in Minecraft!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks (useful for custom Pokemon events)
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=30

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Cobbleverse is a Fabric-based modpack featuring Cobblemon
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-cobbleverse
# - Recommended minimum: 6GB RAM, 10GB disk space
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

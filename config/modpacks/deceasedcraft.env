# DeceasedCraft Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/deceasedcraft
# Modern urban zombie apocalypse with guns, vehicles and city generation

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Exact CurseForge main-file URL: DeceasedCraft_Beta-5.10.17 (release, file 8448820)
# Uploaded 2026-07-17. AUTO_CURSEFORGE reads Forge 47.4.0 from its manifest.
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/deceasedcraft/files/8448820

# Minecraft Version - DeceasedCraft uses 1.20.1 (Forge)
VERSION=1.20.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.20.1 requires Java 17 (latest image tag now ships Java 25)
JAVA_VERSION=java17

# Memory Allocation - the author recommends 10GB+ for a dedicated server
MEMORY=10G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=deceasedcraft

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (hard is the intended zombie apocalypse experience)
DIFFICULTY=hard

# Game Mode (survival for the apocalypse)
MODE=survival

# Enable PVP
PVP=true

# View Distance (10 is a good balance; city chunks are heavy)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (some items/vehicles require it)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=10G

# Max Memory
MAX_MEMORY=10G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26583

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type (the modpack overrides world generation with cities)
LEVEL_TYPE=minecraft:default

# Generate Structures
GENERATE_STRUCTURES=true

# The pack intentionally has no Nether or End content
ALLOW_NETHER=false

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters (the whole point)
SPAWN_MONSTERS=true

# Spawn NPCs
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§4DeceasedCraft§r - Survive the urban zombie apocalypse!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Required by pack features such as multiblocks and vehicle spawns
ENABLE_COMMAND_BLOCK=true

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the regular (non-DH) stable release. A matching server pack exists, but
# AUTO_CURSEFORGE must select the main file because the server ZIP has no manifest.
# Installed: DeceasedCraft_Beta-5.10.17. Update both URL and ID together.
CF_SLUG=deceasedcraft
CF_FILE_ID=8448820

# Shader mods are client-only but not flagged as such in this pack's manifest;
# keeping colorwheel without oculus crashes the server at mod loading
CF_EXCLUDE_MODS="oculus,colorwheel"

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=1800
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - DeceasedCraft is an urban zombie apocalypse modpack (9M+ downloads)
# - Features huge generated cities, guns, vehicles and zombie hordes
# - A custom CF_API_KEY can be supplied in the shared .env if needed
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-deceasedcraft
# - Author requirement: 8GB minimum server RAM; 10GB+ recommended
# - Players need the same modpack version to connect
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

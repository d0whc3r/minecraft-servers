# Prominence II: Hasturian Era Server Configuration
# Modrinth: https://modrinth.com/modpack/prominence-2-fabric
# RPG adventure modpack with classes, dungeons, quests and loot

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth auto-download
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=prominence-2-fabric

# Minecraft Version - REQUIRED for proper modpack version resolution
# Prominence II uses Minecraft 1.20.1 (Fabric)
VERSION=1.20.1

# Memory Allocation - RPG modpack with many mods needs 6GB+
MEMORY=6G

# External Port (MUST be unique)
SERVER_PORT=25581

# Server Display Name
SERVER_NAME=prominence-2

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (pack balances around normal+)
DIFFICULTY=normal

# Game Mode (survival for the RPG progression)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (some late-game items allow flight)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=26581

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (dungeons and structures are core to the pack)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§5Prominence II§r - Hasturian Era RPG Adventure!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Client-side helpers not flagged as such in the pack manifest (marked
# server=required upstream): they depend on client-only mods (modmenu, s_lib,
# faux-custom-entity-data) that never install on a server, so mod resolution
# fails unless they are excluded too. Match the file names shipped in the pack.
MODRINTH_EXCLUDE_FILES=forgeconfigscreens,mutant-skeleton-armor-tweaks,opacpvp,quests_teams_fixes

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Prominence II: Hasturian Era is a Fabric-based RPG modpack for 1.20.1
# - Features origins/classes, dungeons, bosses, quests and weapon variety
# - One of the most downloaded RPG modpacks (12M+ on CurseForge)
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-prominence-2
# - Recommended minimum: 6GB RAM, 15GB disk space
# - Players need the same modpack version to connect
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

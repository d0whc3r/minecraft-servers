# Zombie Invade 100 Days Server Configuration
# Modrinth: https://modrinth.com/modpack/zombie-invade-100-days
# Modern remake of the "100 Days Zombie Apocalypse" challenge - hordes, sieges
# and base defense (14M+ downloads, #2 most-downloaded modpack on Modrinth)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth auto-download
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=zombie-invade-100-days

# Minecraft Version - REQUIRED for proper modpack version resolution
# Zombie Invade 100 Days uses Minecraft 1.20.1 (Forge)
VERSION=1.20.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.20.1 requires Java 17 (latest image tag now ships Java 25)
JAVA_VERSION=java17

# Memory Allocation - Horde siege events are RAM/CPU heavy, 6GB+ recommended
MEMORY=6G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=zombie-invade-100-days

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty - apocalypse pack: hard fits the intended experience
DIFFICULTY=hard

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks - keep moderate, horde events spawn many entities)
VIEW_DISTANCE=8

# Simulation Distance (keep low: hundreds of zombies path-find at once)
SIMULATION_DISTANCE=6

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (some travel/vehicles mods need it)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=6G

# Max Memory
MAX_MEMORY=6G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26591

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§4Zombie Invade 100 Days§r - Survive the horde, fortify everything"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Optional: pin a specific modpack release (version number or ID)
# Leave unset to always install the latest release compatible with VERSION
# MODRINTH_VERSION=

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Zombie Invade 100 Days is a Forge 1.20.1 apocalypse survival pack: timed
#   horde invasions, sieges that dig through bases, guns and base defense
# - The most-downloaded adventure/survival pack on Modrinth after client packs
# - Horde nights are CPU-bound: with 10+ players consider 8G and a 4+ core host
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-zombie-invade-100-days
# - Recommended minimum: 6GB RAM, 12GB disk space
# - Players need the same modpack version to connect

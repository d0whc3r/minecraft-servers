# MENAGERIE - Paradoxical Wilds
# https://www.curseforge.com/minecraft/modpacks/menagerie-paradoxical-wilds
# Independent from the older menagerie profile (a different CurseForge project).

# Runtime: Forge is installed at the version declared by the modpack manifest.
TYPE=AUTO_CURSEFORGE
VERSION=1.20.1
JAVA_VERSION=java17
SERVER_NAME=menagerie-paradoxical-wilds

# Pin modpack 2.8.0 (2026-07-16), CurseForge project 1489356.
# AUTO_CURSEFORGE requires the main client pack manifest, not the server ZIP.
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/menagerie-paradoxical-wilds/files/8445852

# Starting allocation; tune MEMORY after observing actual server usage.
MEMORY=6G
USE_AIKAR_FLAGS=true

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
PVP=true
HARDCORE=false
FORCE_GAMEMODE=false
ALLOW_FLIGHT=true

# World and exploration
LEVEL=world
LEVEL_TYPE=minecraft:default
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
GENERATE_STRUCTURES=true
ALLOW_NETHER=true
SPAWN_ANIMALS=true
SPAWN_MONSTERS=true
SPAWN_NPCS=true

# Access defaults follow the other profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
# Game traffic uses menagerie-paradoxical-wilds.<MC_ROUTER_DOMAIN>.
ENABLE_RCON=true
RCON_PORT=26593
BROADCAST_RCON_TO_OPS=false

# Display and logging
MOTD="MENAGERIE - Paradoxical Wilds | 2.8.0"
ENABLE_ROLLING_LOGS=true
TZ=Europe/Madrid

# BlockFront 0.9.0.30b
# https://modrinth.com/modpack/blockfront-mod-pack

# The official mrpack manifest pins Minecraft 1.21.1 and NeoForge 21.1.248.
TYPE=MODRINTH
MODRINTH_MODPACK=blockfront-mod-pack
MODRINTH_VERSION=qeuo8ALS
MODRINTH_LOADER=neoforge
VERSION=1.21.1
JAVA_VERSION=java21
SERVER_NAME=blockfront

# Local initial estimate for this small pack; tune after observing real matches.
MEMORY=4G

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
PVP=true
ALLOW_FLIGHT=true

# The mrpack contains no world or configuration overrides, so no custom world
# preset is required.
LEVEL=world
LEVEL_TYPE=minecraft:default
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
GENERATE_STRUCTURES=true
ALLOW_NETHER=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26597
BROADCAST_RCON_TO_OPS=false

USE_AIKAR_FLAGS=true
ENABLE_ROLLING_LOGS=true

# DawnCraft: Echoes of Legends Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/dawn-craft
# Open-world RPG adventure: Souls-like bosses, quests, dungeons and loot (10M+ downloads)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download (Forge-based modpack)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/dawn-craft

# Minecraft Version - DawnCraft 2.x uses Minecraft 1.18.2 (Forge, Java 17 auto-selected)
VERSION=1.18.2

# Memory Allocation - Heavy RPG with custom bosses and worldgen, 8GB+ recommended
MEMORY=8G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=dawncraft

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty - the pack balances combat around hard difficulty
DIFFICULTY=hard

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP - keep off: the pack already has its own PvP arenas/duel mods
PVP=false

# View Distance (chunks, recommended: 10-12 for modded; custom worldgen is heavy)
VIEW_DISTANCE=8

# Simulation Distance
SIMULATION_DISTANCE=6

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (mounts and travel mods need it)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26587

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type - the pack ships its own custom world generation (TerraForged)
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6DawnCraft§r - Echoes of Legends - RPG soulslike adventure"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the latest release file. Installed: DawnCraft 2.0.16_hf
# - remove/update CF_FILE_ID to move to a newer release
CF_SLUG=dawn-craft
CF_FILE_ID=7243862

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - DawnCraft is a Forge 1.18.2 open-world RPG (Souls-like bosses, Epic Fight,
#   quests, dungeons, structured progression)
# - The most-cited adventure modpack in 2025/2026 guides (10M+ downloads)
# - Quest progress is stored server-side; clients need the same pack version
# - Custom worldgen is CPU-heavy at spawn: first chunks take a while to generate
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-dawncraft
# - Recommended minimum: 8GB RAM, 15GB disk space

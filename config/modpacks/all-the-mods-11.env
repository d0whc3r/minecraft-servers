# All The Mods 11 (ATM11) Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/all-the-mods-11
# Next generation of the ATM kitchen-sink series, on Minecraft 26.1.x (NeoForge)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Java Version - MC 26.1.x requires Java 25+ (class version 69.0)
JAVA_VERSION=java25

# Server Type - CurseForge auto-download (NeoForge-based modpack)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/all-the-mods-11

# Minecraft Version - ATM11 currently targets MC 26.1.2
VERSION=26.1.2

# Memory Allocation - Massive kitchen-sink modpack needs 8GB+ for smooth operation
MEMORY=8G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=all-the-mods-11

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26589

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§2All The Mods 11§r - The kitchen sink, next generation"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the current beta build. Installed: All the Mods 11 0.7.0-beta (MC 26.1.2)
# - The pack is in active beta; remove/update CF_FILE_ID to move to a newer
#   release, or delete both lines to always track latest
CF_SLUG=all-the-mods-11
CF_FILE_ID=8758210

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - ATM11 is the successor of ATM10 (configured here as all-the-mods-10) and
#   the first ATM generation on Minecraft 26.x / NeoForge
# - BETA: pack updates can be breaking between builds - the pin above keeps
#   the server reproducible; bump it deliberately
# - Players must join from the matching CurseForge ATM11 build
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-all-the-mods-11
# - Recommended minimum: 8GB RAM, 20GB disk space

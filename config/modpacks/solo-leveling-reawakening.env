# Solo Leveling - Reawakening Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/solo-leveling-reawakening
# A Solo Leveling themed modpack with hunter system, dungeons, and progression

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/solo-leveling-reawakening

# Pinned modpack version — locks to a specific release so it does NOT auto-update.
# Current: SLR-1.7.2 (v1.7.2). To change: grab the file ID from the CurseForge
# Files tab (the number in .../files/NNNNNNN). Delete CF_FILE_ID to track latest again.
CF_FILE_ID=8195039

# Minecraft Version - From modpack info
VERSION=1.20.1

# Memory Allocation - RPG modpacks typically need 4-6GB
MEMORY=4G

# External Port (MUST be unique - check other servers)
SERVER_PORT=25571

# Server Display Name
# IMPORTANT: This is used for the Docker container name - NO SPACES, lowercase only!
# Docker container will be named: mc-{SERVER_NAME}
SERVER_NAME=solo-leveling-reawakening

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (RPG modpacks work well with small-medium groups)
MAX_PLAYERS=20

# Game Difficulty (normal recommended for balanced progression)
DIFFICULTY=normal

# Game Mode (survival for RPG progression)
MODE=survival

# Enable PVP (can be enabled for player vs player combat)
PVP=true

# View Distance (10-12 recommended for exploration)
VIEW_DISTANCE=12

# Simulation Distance
SIMULATION_DISTANCE=10

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (recommended for controlled access)
ENABLE_WHITELIST=false

# Allow Flight (RPG mods often include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=4G

# Max Memory
MAX_MEMORY=4G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port (unique per server)
RCON_PORT=26571

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Solo Leveling: Reawakening§r - Rise to Power!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Force synchronize (re-evaluate modpack on restart)
CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
CF_SKIP_UPDATE_CHECK=false

# ============================================================================
# AUTOPAUSE (Optional)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable (good for resource savings)
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=300
# AUTOPAUSE_TIMEOUT_INIT=300

# ============================================================================
# NOTES
# ============================================================================
# - Solo Leveling: Reawakening is an RPG modpack with hunter progression
# - First startup will take longer as it downloads the modpack
# - Check logs with: docker logs -f mc-solo-leveling-reawakening
# - Recommended minimum: 4GB RAM, 8GB disk space
# - Players need the same modpack version to connect
# - Consider enabling whitelist for controlled access
# - IMPORTANT: SERVER_NAME is used for Docker container name - must be lowercase, no spaces!
# - Docker container name will be: mc-{SERVER_NAME}
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

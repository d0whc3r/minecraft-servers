# SoloCraft Modpack Configuration
# Modrinth: https://modrinth.com/modpack/solocraft-modpack
# A survival-focused modpack optimized for solo or small group play

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - Modrinth modpack loader
TYPE=MODRINTH

# Modrinth Modpack (project slug or URL)
MODRINTH_MODPACK=solocraft-modpack

# Minecraft Version - REQUIRED for proper modpack version resolution
# SoloCraft uses Minecraft 1.20.1
VERSION=1.20.1

# Memory Allocation - Solo-focused modpacks typically need 3-4GB
MEMORY=3G

# External Port (MUST be unique)
SERVER_PORT=25572

# Server Display Name
# IMPORTANT: Used for Docker container name - must be lowercase, no spaces
# Docker container will be: mc-{SERVER_NAME}
SERVER_NAME=solocraft-modpack

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (designed for solo/small groups)
MAX_PLAYERS=10

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=false

# View Distance (chunks, recommended: 8-10 for solo play)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (recommended for small groups)
ENABLE_WHITELIST=false

# Allow Flight
ALLOW_FLIGHT=false

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 3GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=3G

# Max Memory
MAX_MEMORY=3G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port
RCON_PORT=25575

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# MODRINTH SPECIFIC SETTINGS
# ============================================================================

# Modrinth Version Type (release, beta, or alpha)
# Leave unset to auto-select latest stable
# MODRINTH_MODPACK_VERSION_TYPE=release

# Modrinth Loader (auto-detected, but can specify: fabric, forge, quilt)
# MODRINTH_LOADER=fabric

# Exclude client-side mods that shouldn't run on server
# Uncomment and add mods if needed
# MODRINTH_EXCLUDE_FILES: |
#   clientmod1
#   clientmod2

# Force include specific mods
# MODRINTH_FORCE_INCLUDE_FILES: |
#   servermod1

# Force synchronize (re-evaluate includes/excludes on restart)
# MODRINTH_FORCE_SYNCHRONIZE=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6SoloCraft§r - Survival Perfected"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# AUTOPAUSE (Optional - ideal for solo servers)
# ============================================================================

# Auto-pause server when no players are online (great for solo play)
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=300
# AUTOPAUSE_TIMEOUT_INIT=300

# ============================================================================
# NOTES
# ============================================================================
# - SoloCraft is optimized for solo or small group survival gameplay
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-solocraft-modpack
# - Recommended minimum: 3GB RAM, 6GB disk space
# - Consider enabling AUTOPAUSE for resource savings when playing solo
# - For full Modrinth options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/modrinth-modpacks/

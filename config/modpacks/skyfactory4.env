# SkyFactory 4 4.2.4
# https://www.curseforge.com/minecraft/modpacks/skyfactory-4

# Runtime declared by the official 4.2.4 manifest: Minecraft 1.12.2,
# Forge 14.23.5.2860 and Java 8.
TYPE=AUTO_CURSEFORGE
VERSION=1.12.2
JAVA_VERSION=java8
SERVER_NAME=skyfactory4

# Pin the main CurseForge file, not the separate server ZIP. AUTO_CURSEFORGE
# reads the client manifest and installs its server-compatible contents.
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/skyfactory-4/files/3565683
CF_SLUG=skyfactory-4
CF_FILE_ID=3565683

# The official server pack recommends at least 4 GB; keep headroom for this
# repository's ten-player profile.
MEMORY=6G

# Gameplay
MAX_PLAYERS=10
DIFFICULTY=normal
MODE=survival
PVP=true
ALLOW_FLIGHT=true
VIEW_DISTANCE=10

# Classic SkyFactory 4 world preset. These values must be present before the
# first world is generated or Minecraft will create a normal overworld.
LEVEL=world
LEVEL_TYPE=DEFAULT
GENERATOR_SETTINGS={"Topography-Preset":"Sky Factory 4"}
SPAWN_PROTECTION=0
ALLOW_NETHER=true
ENABLE_COMMAND_BLOCK=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26565

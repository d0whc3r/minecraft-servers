# SkyFactory 4 Server Configuration

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.12.2

# Memory Allocation
MEMORY=4G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/skyfactory-4

# Server Display Name
SERVER_NAME=SkyFactory 4

# External Port
SERVER_PORT=25566

# Maximum Players
MAX_PLAYERS=10

# Game Difficulty
DIFFICULTY=normal

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance
VIEW_DISTANCE=10

# Online Mode
ONLINE_MODE=false

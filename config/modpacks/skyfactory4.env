# SkyFactory 4 Server Configuration

JAVA_VERSION=java8
# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.12.2

# Memory Allocation (SkyFactory 4 needs 5-6GB for smooth operation)
MEMORY=6G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/skyfactory-4

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
# IMPORTANT: Used for Docker container name - lowercase, no spaces
# Docker container: mc-{SERVER_NAME}
SERVER_NAME=skyfactory4

# Maximum Players
MAX_PLAYERS=10

# Game Difficulty
DIFFICULTY=normal

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance
VIEW_DISTANCE=10

# Online Mode
ONLINE_MODE=false

# RCON
ENABLE_RCON=true
RCON_PORT=26565

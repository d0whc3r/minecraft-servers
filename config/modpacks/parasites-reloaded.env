# Parasites: Reloaded 1.3.0
# https://modrinth.com/modpack/parasites-reloaded

# The Modrinth release is labelled 1.3.0, while its uploaded file and internal
# manifest say 1.1.0. Pinning the immutable version ID removes that ambiguity.
TYPE=MODRINTH
MODRINTH_MODPACK=parasites-reloaded
MODRINTH_VERSION=A3ktvMQw
MODRINTH_LOADER=forge
VERSION=1.12.2
JAVA_VERSION=java8
SERVER_NAME=parasites-reloaded

# Initial server estimate. The author's 6 GB recommendation is specifically
# for a shader-enabled client, not a published dedicated-server requirement.
MEMORY=6G

# Gameplay
MAX_PLAYERS=20
DIFFICULTY=hard
MODE=survival
PVP=true
ALLOW_FLIGHT=true

# The shipped Biomes O' Plenty config explicitly leaves its custom world type
# disabled by default, so preserve the normal 1.12.2 world type.
LEVEL=world
LEVEL_TYPE=DEFAULT
VIEW_DISTANCE=10
GENERATE_STRUCTURES=true
ALLOW_NETHER=true

# Access defaults follow the other local profiles in this repository.
ONLINE_MODE=false
ENABLE_WHITELIST=false

# Host-local administration; credentials come from the shared .env.
ENABLE_RCON=true
RCON_PORT=26596
BROADCAST_RCON_TO_OPS=false

ENABLE_ROLLING_LOGS=true

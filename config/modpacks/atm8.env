# All The Mods 8 Server Configuration

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# Minecraft Version
VERSION=1.20.1

# Memory Allocation (ATM8 requires 6-8GB minimum for stable operation)
MEMORY=6G

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/all-the-mods-8

# Server Display Name
SERVER_NAME=atm8

# External Port (default Minecraft port)
SERVER_PORT=25565

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty
DIFFICULTY=normal

# Game Mode
GAMEMODE=survival

# Enable PVP
PVP=true

# View Distance (reduce if performance issues)
VIEW_DISTANCE=8

# Online Mode
ONLINE_MODE=false

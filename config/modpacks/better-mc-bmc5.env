# Better MC [NEOFORGE] BMC5 Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/better-mc-neoforge-bmc5
# Enhanced vanilla+ modpack (BMC4 successor) with new biomes, structures, tech and magic

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Server Type - CurseForge auto-download (NeoForge-based modpack)
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/better-mc-neoforge-bmc5

# Minecraft Version - BMC5 uses Minecraft 1.21.1 (NeoForge)
VERSION=1.21.1

# Docker image tag (itzg/minecraft-server:<tag>) - picks the container JVM
# MC 1.21.1 requires Java 21 (latest image tag now ships Java 25)
JAVA_VERSION=java21

# Memory Allocation - Enhanced vanilla+ with modern worldgen needs 8GB for headroom
MEMORY=8G

# Server slug (lowercase; builds the player route <name>.<MC_ROUTER_DOMAIN>)
SERVER_NAME=better-mc-bmc5

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure, spectator)
MODE=survival

# Enable PVP
PVP=true

# View Distance (chunks, recommended: 10-12 for modded)
VIEW_DISTANCE=10

# Simulation Distance
SIMULATION_DISTANCE=8

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (enable to manually manage allowed players)
ENABLE_WHITELIST=false

# Allow Flight (many mods include flight mechanics)
ALLOW_FLIGHT=true

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (recommended for modded servers with 4GB+ RAM)
USE_AIKAR_FLAGS=true

# Initial Memory (same as MEMORY for modded servers)
INIT_MEMORY=8G

# Max Memory
MAX_MEMORY=8G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON port (unique, managed range 26565-26664) - bound to 127.0.0.1, host-local admin only
RCON_PORT=26588

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§aBetter MC BMC5§r - Vanilla, but so much better! (NeoForge 1.21.1)"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Pin the latest release file. Installed: BMC5 [NEOFORGE] v52 (1.21.1)
# - remove/update CF_FILE_ID to move to a newer release
CF_SLUG=better-mc-neoforge-bmc5
CF_FILE_ID=8598260

# Shader mods are flagged client-only and skipped automatically; if a pack
# update hard-crashes on a shader-adjacent mod, exclude it here (see
# better-mc-bmc4.env for the pattern)

# ============================================================================
# AUTOPAUSE (Optional - for resource optimization)
# ============================================================================

# Auto-pause server when no players are online
# Uncomment to enable
# ENABLE_AUTOPAUSE=true
# AUTOPAUSE_TIMEOUT_EST=3600
# AUTOPAUSE_TIMEOUT_INIT=600

# ============================================================================
# NOTES
# ============================================================================
# - Better MC BMC5 is the NeoForge 1.21.1 successor to BMC4 (already configured
#   in this repo as better-mc-bmc4)
# - Adds new biomes (Tectonic/Biomes O' Plenty style worldgen), structures,
#   dungeons, tech (Create, Mekanism) and magic (Ars Nouveau, Iron's Spells)
# - First startup will take longer as it downloads and installs the modpack
# - Check logs with: docker logs -f mc-better-mc-bmc5
# - Recommended minimum: 8GB RAM, 15GB disk space
# - Players need the NeoForge (not Forge/Fabric) variant of the pack to connect

# Amazing FPS Booster Server Configuration
# CurseForge: https://www.curseforge.com/minecraft/modpacks/amazing-fps-booster
# Performance optimization modpack - more powerful than OptiFine
#
# ⚠️  WARNING: THIS IS A CLIENT-ONLY MODPACK ⚠️
# This modpack contains client-side optimization mods (rendering, FPS improvements)
# that cannot run on a server. It will fail to start with mixin errors.
#
# Use case: Client-side performance improvement only
# Server alternative: Use server-side performance mods like Lithium, Starlight, etc.
#
# STATUS: NOT SUITABLE FOR SERVER USE - WILL FAIL TO START
# ============================================================================

# ============================================================================
# THIS CONFIGURATION IS DISABLED - CLIENT-ONLY MODPACK
# ============================================================================

# Server Type - CurseForge auto-download
TYPE=AUTO_CURSEFORGE

# CurseForge Modpack URL
CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/amazing-fps-booster

# Minecraft Version - Recent Fabric version for optimization
VERSION=1.20.6

# Memory Allocation - Optimized modpack, 2-3GB sufficient
MEMORY=2G

# External Port (MUST be unique - check other servers)
SERVER_PORT=25573

# Server Display Name
# IMPORTANT: This is used for the Docker container name - NO SPACES, lowercase only!
# Docker container will be named: mc-{SERVER_NAME}
SERVER_NAME=amazing-fps-booster

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Maximum Players (lightweight optimization modpack)
MAX_PLAYERS=10

# Game Difficulty (normal for balanced gameplay)
DIFFICULTY=normal

# Game Mode (survival for standard play)
MODE=survival

# Enable PVP (can be enabled for player interaction)
PVP=true

# View Distance (optimized for performance, can be increased)
VIEW_DISTANCE=8

# Simulation Distance
SIMULATION_DISTANCE=6

# ============================================================================
# NETWORK & SECURITY
# ============================================================================

# Online Mode (require Mojang authentication)
ONLINE_MODE=false

# Whitelist (optional for performance-focused servers)
ENABLE_WHITELIST=false

# Allow Flight (typically disabled for performance)
ALLOW_FLIGHT=false

# ============================================================================
# PERFORMANCE & JVM
# ============================================================================

# Use Aikar's Flags (essential for optimization modpack)
USE_AIKAR_FLAGS=true

# Initial Memory
INIT_MEMORY=2G

# Max Memory
MAX_MEMORY=2G

# ============================================================================
# RCON (Remote Console)
# ============================================================================

# Enable RCON (recommended for management scripts)
ENABLE_RCON=true

# RCON Port (unique per server)
RCON_PORT=25578

# Broadcast RCON to Ops
BROADCAST_RCON_TO_OPS=false

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# World Name/Level
LEVEL=world

# Level Type
LEVEL_TYPE=minecraft:default

# Generate Structures (villages, temples, etc.)
GENERATE_STRUCTURES=true

# Allow Nether
ALLOW_NETHER=true

# Spawn Animals
SPAWN_ANIMALS=true

# Spawn Monsters
SPAWN_MONSTERS=true

# Spawn NPCs (villagers)
SPAWN_NPCS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Server MOTD (message of the day)
MOTD="§6Amazing FPS Booster§r - Optimized Performance!"

# Announce Player Achievements
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Enable Command Blocks
ENABLE_COMMAND_BLOCK=false

# Player Idle Timeout (minutes, 0=disabled)
PLAYER_IDLE_TIMEOUT=0

# Enable Rolling Logs
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC

# ============================================================================
# CURSEFORGE SPECIFIC SETTINGS
# ============================================================================

# Force synchronize (re-evaluate modpack on restart)
CF_FORCE_SYNCHRONIZE=false

# Skip modpack update check (use local cached version)
CF_SKIP_UPDATE_CHECK=false

# ============================================================================
# AUTOPAUSE (Recommended for performance servers)
# ============================================================================

# Auto-pause server when no players are online
# Highly recommended for optimization modpacks to save resources
ENABLE_AUTOPAUSE=true
AUTOPAUSE_TIMEOUT_EST=300
AUTOPAUSE_TIMEOUT_INIT=300

# ============================================================================
# NOTES
# ============================================================================
# - Amazing FPS Booster is a performance optimization modpack (more powerful than OptiFine)
# - First startup will take longer as it downloads the modpack
# - Check logs with: docker logs -f mc-amazing-fps-booster
# - Recommended minimum: 2GB RAM, 4GB disk space
# - Players need the same modpack version to connect
# - Autopause is enabled by default to save resources when no players online
# - IMPORTANT: SERVER_NAME is used for Docker container name - must be lowercase, no spaces!
# - Docker container name will be: mc-{SERVER_NAME}
# - For full CurseForge options: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/mod-platforms/curseforge-modpacks/

CF_EXCLUDE_MODS="fancymenu,entityculling,fps-reducer,mantle-gg"

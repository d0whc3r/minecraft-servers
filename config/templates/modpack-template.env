# Modpack Configuration Template
# This file is used as a template when adding new servers

# Server Type (VANILLA, FORGE, FABRIC, PAPER, AUTO_CURSEFORGE)
TYPE={{TYPE}}

# Minecraft Version (e.g., 1.20.1, 1.19.2, 1.12.2)
VERSION={{VERSION}}

# Memory Allocation (e.g., 2G, 4G, 8G)
MEMORY={{MEMORY}}

# CurseForge Modpack URL (required if TYPE=AUTO_CURSEFORGE)
CF_PAGE_URL={{CF_PAGE_URL}}

# Server Display Name (shown in server list)
SERVER_NAME={{SERVER_NAME}}

# External Port (unique per server)
SERVER_PORT={{SERVER_PORT}}

# Maximum Players
MAX_PLAYERS={{MAX_PLAYERS}}

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=normal

# Game Mode (survival, creative, adventure)
GAMEMODE=survival

# Enable PVP (true/false)
PVP=true

# View Distance (chunks, default: 10)
VIEW_DISTANCE=10

# Online Mode (require Mojang authentication)
ONLINE_MODE=true

---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Status and management of the Minecraft servers",
} = Astro.props;
const path = Astro.url.pathname;
const isAdmin = path.startsWith("/admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header
      class="flex flex-col items-start justify-between gap-2.5 border-b border-edge2 bg-panel px-[clamp(1rem,4vw,2rem)] py-2.5 sm:flex-row sm:items-center"
    >
      <a class="flex items-center gap-2.5 text-ink no-underline" href="/">
        <svg
          class="size-6.5 [image-rendering:pixelated]"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <rect width="16" height="16" rx="2" fill="#3fd68f"></rect>
          <!-- creeper face, pixel style -->
          <rect x="3" y="3" width="4" height="4" fill="#0e1319"></rect>
          <rect x="9" y="3" width="4" height="4" fill="#0e1319"></rect>
          <rect x="6" y="7" width="4" height="3" fill="#0e1319"></rect>
          <rect x="4" y="10" width="3" height="4" fill="#0e1319"></rect>
          <rect x="9" y="10" width="3" height="4" fill="#0e1319"></rect>
        </svg>
        <span class="text-[1.02rem] font-semibold tracking-[0.01em]"
          >Minecraft Panel</span
        >
      </a>
      <nav class="flex gap-1 text-sm" aria-label="Sections">
        <a
          href="/"
          aria-current={isAdmin ? undefined : "page"}
          class="rounded-lg px-3 py-1.5 text-dim no-underline hover:bg-raise hover:text-ink aria-[current=page]:bg-raise aria-[current=page]:font-semibold aria-[current=page]:text-ink"
        >
          Dashboard
        </a>
        <a
          href="/admin"
          aria-current={isAdmin ? "page" : undefined}
          class="rounded-lg px-3 py-1.5 text-dim no-underline hover:bg-raise hover:text-ink aria-[current=page]:bg-raise aria-[current=page]:font-semibold aria-[current=page]:text-ink"
        >
          Admin
        </a>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-[1180px] flex-1 p-[clamp(1rem,3vw,2rem)]">
      <slot />
    </main>
    <footer
      class="flex items-center justify-between border-t border-edge2 px-[clamp(1rem,4vw,2rem)] py-4 text-[0.85rem] text-dim"
    >
      <span>minecraft-servers · management panel</span>
      <span class="font-mono text-[0.92em]">docker + rcon</span>
    </footer>
  </body>
</html>

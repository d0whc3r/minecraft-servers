---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 · Minecraft Servers">
  <div
    class="mx-auto mt-[8vh] flex w-full max-w-[380px] flex-col items-start gap-3.5 rounded-2xl border border-edge bg-panel p-6"
  >
    <h2 class="m-0">Page not found</h2>
    <p class="m-0 text-dim">The address you requested does not exist.</p>
    <a
      class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-transparent bg-ok px-3.5 py-2 text-sm font-semibold text-[#0c130c] no-underline transition-colors hover:bg-[#4fc782]"
      href="/">Back to dashboard</a
    >
  </div>
</Layout>

# apps/web docker compose settings — copy to apps/web/.env
# (the compose file reads this file automatically; it is gitignored).

# HTTP port the panel serves on the host (host networking).
PANEL_PORT=3777

# Admin credentials. Leave MCPANEL_PASSWORD empty to have the panel generate
# a random one on first boot and print it once in `docker compose logs panel`.
MCPANEL_USER=admin
MCPANEL_PASSWORD=

# Lock the dashboard behind the login as well (default: public dashboard).
#MCPANEL_PUBLIC_VIEW=false

# Timezone for the panel logs.
TZ=UTC

# Host path of this repo checkout (e.g. /home/you/minecraft-servers). The
# panel starts/stops servers by running scripts/*.sh, and those scripts pass
# bind-mount sources to the HOST Docker daemon - /repo only exists inside the
# panel container. `pnpm run panel:start` sets this automatically from the
# directory it runs in; pin it here only if you launch docker compose by hand.
#MCPANEL_HOST_ROOT=/absolute/path/to/minecraft-servers
